# Godot 4+ specific ignores
.godot/
/android/

# 本地运行数据：编辑器缓存、测试用 APPDATA、存档
.runtime/

# 打包产物与导出
Delivery/
export/
*.zip

# 测试输出（截图、日志、结果 json），由 Run_Tests.ps1 生成
tests/output/

# 个人工具配置
.codex/
.vscode/
.idea/

# C# build and IDE output
bin/
obj/
.vs/

# 音频素材的压缩包、解压出来的文件夹、音效对照表（不是代码，不进仓库）
assets/audio/*.7z
assets/audio/*.xlsx
assets/audio/NNZ*/
