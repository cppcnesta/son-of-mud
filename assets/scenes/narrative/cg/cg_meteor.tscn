[sub_resource type="Resource" id="Sub_0"]
script = ExtResource("s_sub")
Speaker = "旁白"
Text = "在第二个世界的某一天夜里，祂依旧在重塑他的身体，那是十年中的某一个瞬间，有一颗星从天上划过。"
Start = 2.25
End = 10.99

[sub_resource type="Resource" id="Sub_1"]
script = ExtResource("s_sub")
Speaker = "穆尔图库尔"
Text = "那是什么？"
Start = 11.44
End = 14.04

[sub_resource type="Resource" id="Sub_2"]
script = ExtResource("s_sub")
Speaker = "伊姆杜"
Text = "星。"
Start = 14.49
End = 17.09

[sub_resource type="Resource" id="Sub_3"]
script = ExtResource("s_sub")
Speaker = "穆尔图库尔"
Text = "它为什么会掉下来？"
Start = 17.54
End = 20.14

[sub_resource type="Resource" id="Sub_4"]
script = ExtResource("s_sub")
Speaker = "伊姆杜"
Text = "星是神写在天上的命运。写完了，就会落下来。"
Start = 20.59
End = 24.58

[sub_resource type="Resource" id="Sub_5"]
script = ExtResource("s_sub")
Speaker = "穆尔图库尔"
Text = "那您写的是什么？"
Start = 25.03
End = 27.63

[sub_resource type="Resource" id="Sub_6"]
script = ExtResource("s_sub")
Speaker = "旁白"
Text = "父亲看了那颗星很久。他把手放在我的头上，星从天这头落到那头。然后他收回手，站起来。"
Start = 28.08
End = 35.87

[sub_resource type="Resource" id="Sub_7"]
script = ExtResource("s_sub")
Speaker = "伊姆杜"
Text = "穆尔图库尔，闭上眼睛吧。"
Start = 36.32
End = 38.92

[sub_resource type="Resource" id="Sub_8"]
script = ExtResource("s_sub")
Speaker = "旁白"
Text = "父亲继续修复我破碎的躯体，时隔一个百年，我再次感受他的心跳和手指的纹路。我希望这一刻像永远一样久。"
Start = 39.37
End = 48.68

[sub_resource type="Resource" id="Sub_9"]
script = ExtResource("s_sub")
Speaker = "旁白"
Text = "然而就如同那颗星从天这头落到那头。他的手在我头上，停了那么久。"
Start = 49.13
End = 55.02

[sub_resource type="Resource" id="Sub_10"]
script = ExtResource("s_sub")
Speaker = "旁白"
Text = "只有那么久。"
Start = 55.47
End = 59.57

